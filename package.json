{
  "name": "chrishop-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-dependencies.js && pnpm --filter @chrishop/web run postinstall",
    "build": "turbo run build && tsx scripts/build-worker.ts",
    "build:apps": "turbo run build",
    "build:worker": "tsx scripts/build-worker.ts",
    "build:prod": "turbo run build && tsx scripts/build-worker.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:web": "turbo run dev",
    "dev:wrangler": "wrangler dev --port 8787",
    "dev:types": "wrangler types",
    "dev:db": "tsx scripts/seed-db.ts",
    "check": "turbo run check",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "test": "turbo run test",
    "test:unit": "turbo run test && tsx --test tests/integration/dependency-control.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts tests/spike/**/*.test.ts",
    "test:spike": "tsx --test tests/spike/**/*.test.ts",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "benchmark": "tsx scripts/benchmark-bundle.ts",
    "verify:images": "tsx scripts/verify-image-pipeline.ts",
    "verify:local": "tsx scripts/verify-local.ts",
    "lint": "turbo run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:security": "pnpm audit --audit-level=high",
    "audit:roadmap": "tsx scripts/audit-roadmap.ts",
    "audit:backlog": "tsx scripts/audit-roadmap.ts",
    "branch": "bash scripts/create-branch.sh",
    "deploy:prod": "tsx scripts/promote-production.ts",
    "release:notes": "tsx scripts/compose-release-notes.ts",
    "pm:prioritize": "tsx scripts/prioritize-backlog.ts",
    "seed": "tsx scripts/seed-db.ts",
    "d1:setup": "bash scripts/d1-local-setup.sh",
    "d1:migrate:local": "wrangler d1 migrations apply chrishop-prod-db --local",
    "db:migrate:local": "wrangler d1 migrations apply chrishop-prod-db --local",
    "db:seed": "tsx scripts/seed-db.ts",
    "cf:types": "wrangler types",
    "preview:cleanup": "tsx scripts/cleanup-preview-environments.ts"
  },
  "devDependencies": {
    "@chrishop/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20240923.0",
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.23.13",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.100.0"
  },
  "pnpm": {
    "overrides": {
      "joi": ">=18.2.5",
      "js-yaml": ">=4.3.2",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.4",
      "undici": ">=6.28.0",
      "ws": ">=8.21.0"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
