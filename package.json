{
  "name": "chrishop-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "turbo run check",
    "test": "turbo run test",
    "test:unit": "turbo run test && tsx --test tests/integration/dependency-control.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts tests/spike/**/*.test.ts",
    "test:spike": "tsx --test tests/spike/**/*.test.ts",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "benchmark": "tsx scripts/benchmark-bundle.ts",
    "verify:local": "tsx scripts/verify-local.ts",
    "lint": "turbo run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:security": "pnpm audit --audit-level=high",
    "seed": "pnpm --filter cms seed"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.33.5"
    }
  },
  "devDependencies": {
    "@chrishop/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20240923.0",
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.23.13",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.100.0"
  },
  "pnpm": {
    "overrides": {
      "joi": ">=18.2.5",
      "js-yaml": ">=4.3.2",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.4",
      "undici": ">=6.28.0",
      "ws": ">=8.21.0"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
