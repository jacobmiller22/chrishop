# ==============================================================================
# CHRISHOP E-COMMERCE PLATFORM - LOCAL ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#   cp .env.example apps/web/.dev.vars
#
# DO NOT commit sensitive secrets or production credentials to source control!
# In production, edge secrets are managed via Cloudflare Workers Secrets:
#   wrangler secret put <SECRET_NAME> --env production
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Server Config
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Payload CMS v3 Configuration (Embedded Next.js App Router at /admin)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT auth tokens and encrypting sensitive data in Payload
PAYLOAD_SECRET=development-secret-key-must-be-at-least-32-chars-long
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Shopify Headless Commerce (Storefront API & Webhooks)
# ------------------------------------------------------------------------------
# Custom development store domain (e.g. your-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=chrishop-dev.myshopify.com
# Storefront API public access token
SHOPIFY_STOREFRONT_TOKEN=mock_storefront_access_token_for_local_dev
# Admin API access token (used for catalog sync and order lookups)
SHOPIFY_ADMIN_TOKEN=mock_admin_api_access_token_for_local_dev
# Webhook signing HMAC secret key
SHOPIFY_WEBHOOK_SECRET=mock_webhook_secret_key
# Client-side exposed variables
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=chrishop-dev.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=mock_storefront_access_token_for_local_dev

# ------------------------------------------------------------------------------
# Cloudflare Platform & R2 Object Storage
# ------------------------------------------------------------------------------
# Cloudflare account identifier
CLOUDFLARE_ACCOUNT_ID=mock_cf_account_id
# Scoped Cloudflare API Token (Workers, D1, KV, R2, Zone Routes, Zone DNS edit permissions)
CLOUDFLARE_API_TOKEN=cf_placeholder_api_token_0123456789abcdef
# Target Cloudflare Zone ID for custom domain routing (jacobmiller22.com)
CLOUDFLARE_ZONE_ID=placeholder_cloudflare_zone_id_32hex
# R2 media bucket name for images, catalog assets, and uploads
R2_BUCKET_NAME=chrishop-media
# R2 API credentials (S3-compatible API credentials for development tools)
R2_ACCESS_KEY_ID=mock_r2_key
R2_SECRET_ACCESS_KEY=mock_r2_secret
# R2 S3 endpoint URL
R2_ENDPOINT=http://localhost:3000/mock-r2
# Public CDN URL for serving R2 media assets
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.chrishop.jacobmiller22.com

# ------------------------------------------------------------------------------
# Email Services (Resend Transactional Email Engine)
# ------------------------------------------------------------------------------
# Resend API Key for transactional order receipts and shipping updates
RESEND_API_KEY=re_placeholder_api_key_123456789
# Default 'From' sender email address
EMAIL_FROM=orders@chrishop.jacobmiller22.com

# ------------------------------------------------------------------------------
# Operational Notifications (Discord Webhook Engine)
# ------------------------------------------------------------------------------
# Discord webhook URL for automated order notifications, inventory alerts, and health probes
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/placeholder_id/placeholder_token

# ------------------------------------------------------------------------------
# Observability & Error Tracking (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for edge and client error tracking
NEXT_PUBLIC_SENTRY_DSN=https://placeholder_sentry_dsn@o0.ingest.sentry.io/0
# Better Stack Uptime monitoring API token
BETTER_STACK_UPTIME_KEY=placeholder_better_stack_key
