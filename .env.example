# ==============================================================================
# CHRISHOP E-COMMERCE PLATFORM - LOCAL ENVIRONMENT VARIABLE TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# DO NOT commit sensitive secrets or real credentials to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Server Config
# ------------------------------------------------------------------------------
# Node runtime environment (development, staging, production, test)
NODE_ENV=development
# Development server port for Next.js storefront app
PORT=3000
# Canonical public frontend URL used for Next.js routing and absolute redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Directus CMS endpoint accessible by client and server applications
NEXT_PUBLIC_CMS_URL=http://localhost:8055

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL database name created by Docker Compose dev stack
POSTGRES_DB=chrishop_dev
# Database user for PostgreSQL local development
POSTGRES_USER=chrishop
# Database user password for local development
POSTGRES_PASSWORD=chrishop_dev_secret
# PostgreSQL connection string used by direct DB clients (Kysely / pg)
DATABASE_URL=postgresql://chrishop:chrishop_dev_secret@localhost:5432/chrishop_dev

# ------------------------------------------------------------------------------
# Directus CMS Configuration
# ------------------------------------------------------------------------------
# Secret key used for cryptographic operations in Directus
KEY=chrishop-secret-key
# Secret key used for signing JWT tokens in Directus
SECRET=chrishop-secret-jwt
# Initial administrator account email for local Directus instance
ADMIN_EMAIL=admin@chrishop.com
# Initial administrator account password for local Directus instance
ADMIN_PASSWORD=AdminPassword123!
# URL endpoint for internal API requests to Directus CMS
DIRECTUS_URL=http://localhost:8055

# ------------------------------------------------------------------------------
# Cloudflare R2 / Local MinIO Storage Emulator Configuration
# ------------------------------------------------------------------------------
# Configured Directus storage locations (comma-separated list)
STORAGE_LOCATIONS=s3
# Directus S3 storage driver identifier
STORAGE_S3_DRIVER=s3
# Access key ID for S3 storage (MinIO root user for local dev)
STORAGE_S3_KEY=minioadmin
# Secret access key for S3 storage (MinIO root password for local dev)
STORAGE_S3_SECRET=minioadmin
# Target bucket name for media files and product artwork assets
STORAGE_S3_BUCKET=chrishop-media
# Storage API endpoint (MinIO emulator on http://localhost:9000 for local dev)
STORAGE_S3_ENDPOINT=http://localhost:9000
# S3 region identifier for AWS SDK compatibility
STORAGE_S3_REGION=us-east-1
# Enforce S3 path style addressing required by MinIO local emulator
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_S3_FORCE_PATH_STYLE=true
# Directus cache TTL in seconds for Redis storage transformations (default: 86400s / 24h)
STORAGE_CACHE_TTL=86400

# ------------------------------------------------------------------------------
# Redis OSS Cache & Inventory Reservation Locks
# ------------------------------------------------------------------------------
# Redis host name for local caching and pre-checkout stock reservations
REDIS_HOST=localhost
# Redis port for local caching connection
REDIS_PORT=6379
# Full Redis connection URL
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Stripe Integration Keys (Test Mode)
# ------------------------------------------------------------------------------
# Stripe secret key for backend API calls and Checkout session creation (sk_test_...)
STRIPE_SECRET_KEY=sk_test_51placeholder_secret_key_for_local_dev
# Stripe webhook signing secret obtained from `stripe listen` CLI command (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_for_local_dev
# Stripe publishable key exposed to Next.js client-side UI (pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51placeholder_pub_key_for_local_dev

# ------------------------------------------------------------------------------
# Email Services (Mailpit Local Emulator & Resend API Provider)
# ------------------------------------------------------------------------------
# SMTP server host for local email interception via Mailpit
SMTP_HOST=localhost
# SMTP port for local Mailpit server
SMTP_PORT=1025
# Resend API Key for transaction emails in staging/production (re_...)
RESEND_API_KEY=re_placeholder_api_key_123456789
# Default 'From' sender email address for transactional order updates
EMAIL_FROM=orders@chrishop.com

# ------------------------------------------------------------------------------
# Discord Notifications Engine
# ------------------------------------------------------------------------------
# Discord webhook URL for automated order notifications & system alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/placeholder_id/placeholder_token

# ------------------------------------------------------------------------------
# Observability & Error Tracking (Optional for Local Dev)
# ------------------------------------------------------------------------------
# Sentry DSN for client & server application error reporting
NEXT_PUBLIC_SENTRY_DSN=https://placeholder_sentry_dsn@o0.ingest.sentry.io/0
# Better Stack Uptime monitoring API token
BETTER_STACK_UPTIME_KEY=placeholder_better_stack_key

# ------------------------------------------------------------------------------
# Cloudflare DNS & Caddy Reverse Proxy Configuration
# ------------------------------------------------------------------------------
# Cloudflare API Token with Zone.DNS edit permissions for ACME DNS-01 SSL challenge
CLOUDFLARE_API_TOKEN=cf_placeholder_api_token_0123456789abcdef
# Optional host port overrides for Caddy edge proxy
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
