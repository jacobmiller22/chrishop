{
  "description": "Cloudflare Image Resizing and R2 Media Asset Edge Caching Rules (Story 2.42)",
  "rules": [
    {
      "id": "chrishop-image-resizing-edge-cache",
      "description": "Immutably cache all Cloudflare Image Resizing transforms for 1 year at edge and in browser with Vary: Accept",
      "expression": "(http.request.uri.path starts_with \"/cdn-cgi/image/\")",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "cache_reserve": {
          "eligible": true,
          "minimum_file_size": 0
        },
        "cache_key": {
          "ignore_query_strings_order": true,
          "custom_key": {
            "header": {
              "include": ["accept"]
            }
          }
        },
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable",
          "Vary": "Accept"
        }
      }
    },
    {
      "id": "chrishop-r2-public-media-cache",
      "description": "Cache original R2 media assets at media.chrishop.jacobmiller22.com for 1 year immutable",
      "expression": "(http.host eq \"media.chrishop.jacobmiller22.com\")",
      "action": "set_cache_settings",
      "action_parameters": {
        "cache": true,
        "edge_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "browser_ttl": {
          "mode": "override_origin",
          "default": 31536000
        },
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      }
    }
  ]
}
